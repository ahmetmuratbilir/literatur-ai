# LiteratureAI Environment Variables Example

# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/literature-ai?retryWrites=true&w=majority
# Ikinci MongoDB (istege bagli, ayri Atlas kumesi): kullanici verilerinin gece
# yedegi + DergiPark Turkce dizini. Ana adresle AYNI olamaz. Bos birakilirsa
# yedek alinmaz. Geri yukleme: node scripts/restore-backup.mjs
MONGODB_URI_2=

# Server
NODE_ENV=production
PORT=3000
CLIENT_URL=https://your-client-domain.vercel.app
CORS_ORIGINS=https://your-client-domain.vercel.app

# Academic source configuration
OPENALEX_MAIL=research-contact@example.com
# Ucretsiz: openalex.org hesabindan. Anahtarsiz da calisir AMA arama kumesi yuk
# altindayken anonim aramayi 429 ile kesiyor. GECERSIZ bir anahtar ise 401
# dondurup kaynagi tamamen dusurur: eklemeden sonra `npm run verify-keys` calistir.
OPENALEX_API_KEY=
CORE_API_KEY=your_core_api_key_here
SCOPUS_API_KEY=your_elsevier_scopus_api_key_here
# Scopus varsayilan olarak KAPALI. Ucretsiz asamada kullanilmiyor; gecerli bir
# ticari anahtar olmadan aramaya her seferinde kimlik hatasi uyarisi ekliyor.
SCOPUS_ENABLED=false
# Alias also supported:
# ELSEVIER_API_KEY=your_elsevier_scopus_api_key_here
# Optional institutional token:
# ELSEVIER_INSTTOKEN=your_elsevier_insttoken_here

# Writer AI providers
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=your_groq_api_key_here
# Groq katalogdan model kaldirabiliyor (Llama 3.3 boyle kalkti). Hesabinda
# hangi modeller var: https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b

# Unpaywall ("Ucretsiz PDF" dugmesi). Anahtar yok ama GERCEK bir e-posta zorunlu:
# example.com gibi sablon adresler HTTP 422 ile reddediliyor. Bos kalirsa
# ozellik kapali kalir ve dugme gosterilmez.
UNPAYWALL_EMAIL=

# Optional source key.
# DIKKAT: reddedilen bir anahtar tasimak hic tasimamaktan KOTUDUR. S2 gecersiz
# anahtarda 403 donuyor ve kaynak tamamen dusuyor; anahtarsiz ortak havuz ise
# (429'a acik olsa da) sonuc donduruyor. Anahtarin calistigini once
# `npm run verify-keys` ile dogrula, sonra buraya yaz.
SEMANTIC_SCHOLAR_API_KEY=

# Writer Postcheck Flags
WRITER_POSTCHECK_ENABLED=true
WRITER_CITATION_CHECK_ENABLED=true
WRITER_QUALITY_CHECK_ENABLED=true
WRITER_REVISION_COACH_ENABLED=false
WRITER_GATE_MODE=warn_only

# Abonelik zorunlulugu. Varsayilan kapali: ucret alinmiyorsa var olmayan bir
# aboneligi dogrulamaya calismak kullanicilari disarida birakir.
# Clerk Billing'i kurup plan tanimladiktan SONRA true yap.
BILLING_REQUIRED=false

# Billing zorunluyken servis hatasinda ne olsun:
# true  = kullaniciyi gecir (gelir riski)
# false = engelle (erisim riski)
BILLING_FAIL_OPEN=false

# Admin paneli erisimi. Virgulle ayrilmis Clerk kullanici kimlikleri.
# Bos birakilirsa HIC KIMSE admin degildir (guvenli varsayilan).
# Kendi kimligini Clerk Dashboard > Users sayfasindan alabilirsin (user_ ile baslar).
ADMIN_USER_IDS=

# Yerel gelistirme icin kimlik dogrulama atlatma. Uretimde ASLA calismaz
# (NODE_ENV=production oldugunda kod bunu kesin olarak reddeder).
ALLOW_E2E_TEST_AUTH=false

# --- DeepSeek (birincil saglayici) ---
# Anahtar: platform.deepseek.com/api_keys  (sk- ile baslar)
DEEPSEEK_API_KEY=
# 24 Tem 2026'da deepseek-chat / deepseek-reasoner emekliye ayrildi.
DEEPSEEK_MODEL_FAST=deepseek-flash
# Pro ~4 kat pahali; ihtiyac olursa deepseek-v4-pro yapilabilir.
DEEPSEEK_MODEL_QUALITY=deepseek-flash
# Dusunme modu. Varsayilan kapali: olcumde 72 sn dusunup hic metin uretmedi.
DEEPSEEK_THINKING=false

# Saglayici sirasi. Ilki birincil, digerleri yedek.
# Bir saglayiciyi kapatmak icin listeden cikar; kodu silmeye gerek yok.
AI_PROVIDERS=deepseek,gemini,groq
