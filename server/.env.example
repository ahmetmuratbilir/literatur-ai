PORT=3000

# Elsevier/Scopus (required for Scopus source)
ELSEVIER_API_KEY=

# OpenAlex (optional; you can use without a key but a key helps with polite usage/rate limits)
OPENALEX_API_KEY=

# CORE (optional; without it requests may be limited/blocked)
CORE_API_KEY=

# Groq (required for /api/analyze-query)
GROQ_API_KEY=

# Gemini (optional; query translation falls back when omitted)
GEMINI_API_KEY=

# Semantic Scholar (optional; recommended for citedBy counts and better stability)
SEMANTIC_SCHOLAR_API_KEY=

# Contact Email (recommended for Crossref/OpenAlex 'polite pool' usage)
CONTACT_EMAIL=support@literature-ai.com

# MongoDB (required for history, collections, analyses, and sharing)
MONGODB_URI=

# Shared 30-day search result cache in MongoDB.
# Defaults fit the free 512 MB temporary pool.
SEARCH_CACHE_TTL_DAYS=30
SEARCH_CACHE_MAX_BYTES=536870912
SEARCH_CACHE_MAX_RESULTS=100

# Clerk authentication
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_KEY=

