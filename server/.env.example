PORT=3000

# Elsevier/Scopus (required for Scopus source)
ELSEVIER_API_KEY=

# OpenAlex (optional; you can use without a key but a key helps with polite usage/rate limits)
OPENALEX_API_KEY=

# CORE (optional; without it requests may be limited/blocked)
CORE_API_KEY=

# Groq (required for /api/analyze-query)
GROQ_API_KEY=

